// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres for both dev and prod. Vercel's serverless runtime has no
  // persistent filesystem, so SQLite is not an option for the deployed app.
  //
  // Vercel's Prisma-integrated Postgres exposes two env vars:
  //   PRISMA_DATABASE_URL — pooled (Accelerate) URL, used at runtime
  //   POSTGRES_URL        — direct, non-pooled URL, used for migrations
  // Both are auto-injected when the DB is connected to the project.
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("POSTGRES_URL")
}

model Workflow {
  id        String   @id @default(cuid())
  // Per-browser identity. Set by the client (UUID v4 in localStorage).
  // Workflows are scoped to a clientId so each browser sees only its own.
  // Nullable for backward-compat with rows created before this column existed.
  clientId  String?
  name      String
  nodes     Json
  edges     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, updatedAt])
}
