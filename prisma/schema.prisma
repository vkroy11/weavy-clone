// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres for both dev and prod. Vercel's serverless runtime has no
  // persistent filesystem, so SQLite is not an option for the deployed app.
  // The DATABASE_URL is read from .env.local in dev and from Vercel project
  // env vars in prod.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workflow {
  id        String   @id @default(cuid())
  // Per-browser identity. Set by the client (UUID v4 in localStorage).
  // Workflows are scoped to a clientId so each browser sees only its own.
  // Nullable for backward-compat with rows created before this column existed.
  clientId  String?
  name      String
  nodes     Json
  edges     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, updatedAt])
}
